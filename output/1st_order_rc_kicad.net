# Preliminary EDA Netlist Export - Subject to PCB DRC, ERC, and Layout Verification
(export (version D) (design (source "AnalogFilterSynthesis") (tool "Analog-Filter-Synthesizer"))
  (components
    (comp (ref R1) (value "16k Ohm") (footprint Resistor_SMD:R_0805_2012Metric))
    (comp (ref C1) (value "10nF") (footprint Capacitor_SMD:C_0805_2012Metric))
    (comp (ref J_IN) (value "Conn_01x02") (footprint Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical) (description "Input Signal Header (Pin 1: IN, Pin 2: GND)"))
    (comp (ref J_OUT) (value "Conn_01x02") (footprint Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical) (description "Output Signal Header (Pin 1: OUT, Pin 2: GND)"))
  )
  (nets
    (net (code 1) (name "IN") (node (ref R1) (pin 1)) (node (ref J_IN) (pin 1)))
    (net (code 2) (name "OUT") (node (ref R1) (pin 2)) (node (ref C1) (pin 1)) (node (ref J_OUT) (pin 1)))
    (net (code 3) (name "GND") (node (ref C1) (pin 2)) (node (ref J_IN) (pin 2)) (node (ref J_OUT) (pin 2)))
  )
)
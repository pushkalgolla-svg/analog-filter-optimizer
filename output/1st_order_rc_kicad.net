# Preliminary EDA Netlist Export - Subject to PCB DRC, ERC, and Layout Verification
(export (version D) (design (source "AnalogFilterSynthesis") (tool "Analog-Filter-Synthesizer"))
  (components
    (comp (ref R1) (value "16k Ohm") (footprint Resistor_SMD:R_0805_2012Metric))
    (comp (ref C1) (value "10nF") (footprint Capacitor_SMD:C_0805_2012Metric))
  )
  (nets
    (net (code 1) (name "IN") (node (ref R1) (pin 1)))
    (net (code 2) (name "OUT") (node (ref R1) (pin 2)) (node (ref C1) (pin 1)))
    (net (code 3) (name "GND") (node (ref C1) (pin 2)))
  )
)
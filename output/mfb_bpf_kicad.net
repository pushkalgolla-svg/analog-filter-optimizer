# Preliminary EDA Netlist Export - Subject to PCB DRC, ERC, and Layout Verification
(export (version D) (design (source "AnalogFilterSynthesis") (tool "Analog-Filter-Synthesizer"))
  (components
    (comp (ref R1) (value "63.4k Ohm") (footprint Resistor_SMD:R_0805_2012Metric))
    (comp (ref R2) (value "9.09k Ohm") (footprint Resistor_SMD:R_0805_2012Metric))
    (comp (ref R3) (value "127k Ohm") (footprint Resistor_SMD:R_0805_2012Metric))
    (comp (ref C1) (value "1nF") (footprint Capacitor_SMD:C_0805_2012Metric))
    (comp (ref C2) (value "1nF") (footprint Capacitor_SMD:C_0805_2012Metric))
    (comp (ref U1) (value "OPA1678") (footprint Package_SO:SOIC-8_3.9x4.9mm_P1.27mm) (description "Dual Low-Distortion Audio Op-Amp (SOIC-8, Section A active, Section B terminated)"))
    (comp (ref C_DEC1) (value "100nF") (footprint Capacitor_SMD:C_0805_2012Metric) (description "V+ Decoupling"))
    (comp (ref C_DEC2) (value "100nF") (footprint Capacitor_SMD:C_0805_2012Metric) (description "V- Decoupling"))
  )
  (nets
    (net (code 1) (name "IN") (node (ref R1) (pin 1)))
    (net (code 2) (name "Net-(R1-Pad2)") (node (ref R1) (pin 2)) (node (ref R2) (pin 1)) (node (ref C1) (pin 1)) (node (ref C2) (pin 1)))
    (net (code 3) (name "Net-(C1-Pad2)") (node (ref C1) (pin 2)) (node (ref R3) (pin 1)) (node (ref U1) (pin 2)))
    (net (code 4) (name "OUT") (node (ref C2) (pin 2)) (node (ref R3) (pin 2)) (node (ref U1) (pin 1)))
    (net (code 5) (name "V+") (node (ref U1) (pin 8)) (node (ref C_DEC1) (pin 1)))
    (net (code 6) (name "V-") (node (ref U1) (pin 4)) (node (ref C_DEC2) (pin 1)))
    (net (code 7) (name "GND") (node (ref R2) (pin 2)) (node (ref U1) (pin 3)) (node (ref C_DEC1) (pin 2)) (node (ref C_DEC2) (pin 2)) (node (ref U1) (pin 5)))
    (net (code 8) (name "UNUSED_B") (node (ref U1) (pin 6)) (node (ref U1) (pin 7)))
  )
)